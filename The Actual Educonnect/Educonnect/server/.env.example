# Copy this file to .env and configure.
# .env is ignored by git – never commit secrets.

# SQLite path (optional). Default: ./educonnect.db next to the server.
# On a host with a mounted disk: EDUCONNECT_DB_PATH=/var/data/educonnect.db
# Or: EDUCONNECT_DATA_DIR=/var/data  (creates educonnect.db inside that folder)

# Chat LLM (optional – for AtlasBot chat)
OPENAI_API_KEY=

# Quiz generation uses local Python backend (KeyBERT + T5). Default: http://localhost:5001
# PYTHON_QUIZ_URL=http://localhost:5001
