# Backend API URL — must be reachable from every browser that uses the app.
# Default in code is http://localhost:5000 (fine only on the same machine as the server).
# For phones or other computers on your Wi‑Fi, use this PC's LAN IP, e.g.:
# VITE_API_URL=http://192.168.1.10:5000
# Then restart Vite (npm run dev). Ensure the Node server is running and Windows Firewall allows port 5000.
# VITE_API_URL=http://localhost:5000

# EmailJS - for feedback confirmation and admin responses to users' emails
# Get these from https://www.emailjs.com/ after creating a service and template
# Template variables: to_email, user_name, subject, message, feedback_type
# IMPORTANT: In your EmailJS template, set the "To" field to {{to_email}} so emails reach the recipient
VITE_EMAILJS_SERVICE_ID=your_service_id
VITE_EMAILJS_TEMPLATE_ID=your_template_id
VITE_EMAILJS_PUBLIC_KEY=your_public_key
